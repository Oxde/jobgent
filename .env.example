# Copy to .env (git-ignored) or put these in ~/.config/secrets/env. All are optional.

# AI: one of these. Anthropic wins when both are set. With neither, an MCP agent can do the AI steps.
ANTHROPIC_API_KEY=
KIE_API_KEY=

# LinkedIn: auto (Apify if APIFY_TOKEN is set, else the free guest search), apify, guest or off.
APIFY_TOKEN=
# JOBGENT_LINKEDIN=auto

# Where your data lives.
# JOBGENT_HOME=~/.jobgent
